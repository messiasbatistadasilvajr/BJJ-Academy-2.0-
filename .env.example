# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ASAAS_API_KEY: Asaas API key for payment gateway interactions
ASAAS_API_KEY=""

# ASAAS_WEBHOOK_ACCESS_TOKEN: Security token sent in asaas-access-token header to authenticate webhooks
ASAAS_WEBHOOK_ACCESS_TOKEN=""

# ASAAS_WEBHOOK_SECRET: Secret token for Asaas webhook authentication (alias for ASAAS_WEBHOOK_ACCESS_TOKEN)
ASAAS_WEBHOOK_SECRET=""

# WHATSAPP_API_URL: Endpoint for WhatsApp messaging API (e.g. Evolution API, Z-API, Baileys gateway)
WHATSAPP_API_URL="https://api.evolution-api.com/message/sendText/bjjacademy"

# WHATSAPP_API_KEY: Authentication token for the WhatsApp gateway
WHATSAPP_API_KEY=""

# WHATSAPP_INSTANCE_ID: WhatsApp instance identifier for BJJACADEMY
WHATSAPP_INSTANCE_ID="bjjacademy_matriz"

# ASAAS_ENVIRONMENT: sandbox or production (defaults to sandbox)
ASAAS_ENVIRONMENT="sandbox"

# ASAAS_MASTER_WALLET_ID: Wallet ID of BJJACADEMY Master account to receive split fees & subscriptions
ASAAS_MASTER_WALLET_ID="wallet_master_bjjacademy_01"

# ASAAS_SPLIT_FIXED_FEE: Default fixed commission in BRL per student payment (e.g. 2.00)
ASAAS_SPLIT_FIXED_FEE="2.00"

# REDIS_URL: Optional Redis URL for queue and idempotency caching (falls back to memory queue if not provided)
REDIS_URL=""
