# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ASAAS_API_KEY: Asaas API key for payment gateway interactions
ASAAS_API_KEY=""

# ASAAS_WEBHOOK_ACCESS_TOKEN: Security token sent in asaas-access-token header to authenticate webhooks
ASAAS_WEBHOOK_ACCESS_TOKEN=""

# ASAAS_ENVIRONMENT: sandbox or production (defaults to sandbox)
ASAAS_ENVIRONMENT="sandbox"

# REDIS_URL: Optional Redis URL for queue and idempotency caching (falls back to memory queue if not provided)
REDIS_URL=""
