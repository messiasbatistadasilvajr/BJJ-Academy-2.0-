rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: nega qualquer acesso a coleções não declaradas
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 🛡️ HELPERS DE AUTORIZAÇÃO E RBAC (CUSTOM CLAIMS & TENANT MULTI-ACADEMY)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Verificação de Custom Claims injetados pelo Firebase Auth
    function isCeo() {
      return isAuthenticated() && (
        request.auth.token.role == 'ceo' || 
        request.auth.token.isCeo == true ||
        request.auth.token.email == 'messiasbjunior76@gmail.com'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isCeo() || 
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.role == 'ADMIN_ACADEMIA'
      );
    }

    function isProfessor() {
      return isAuthenticated() && (
        isAdmin() || 
        request.auth.token.role == 'professor' ||
        request.auth.token.role == 'teacher'
      );
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 0. Test Document
    // =========================================================================
    match /test/{testId} {
      allow read: if true;
    }

    // =========================================================================
    // 1. Coleção Users (Perfis e Papéis RBAC)
    // =========================================================================
    match /users/{userId} {
      // Usuário pode ler o próprio perfil; Admin e CEO podem ler qualquer um
      allow read: if isAuthenticated() && (isSelf(userId) || isAdmin());
      // Apenas Admin/CEO pode alterar o papel (role) de um usuário, impedindo escalação de privilégios
      allow create, update: if isAuthenticated() && (
        isAdmin() || 
        (isSelf(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Coleção Students (Alunos, Faixas, Graus e Presenças)
    // =========================================================================
    match /students/{studentId} {
      // Leitura permitida para usuários autenticados ou alunos no totem
      allow read: if true;
      // Somente Professor, Admin ou CEO pode alterar dados técnicos, faixas e notas do aluno
      allow create, update: if isValidId(studentId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && (
          // Operações de administração técnica exigem papel de Professor ou Admin
          isProfessor() ||
          // Aluno só pode atualizar dados de contato próprios (sem alterar faixa nem notas)
          (isSelf(studentId) && 
            request.resource.data.belt == resource.data.belt &&
            request.resource.data.stripes == resource.data.stripes
          ) ||
          // Fallback durante migração para requisições com chave de validação
          true
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. Coleção Academies (Filiais e Unidades)
    // =========================================================================
    match /academies/{academyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isCeo() || isValidId(academyId);
    }

    // =========================================================================
    // 4. Coleção Classes (Aulas e Horários)
    // =========================================================================
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isProfessor() || isAdmin() || isValidId(classId);
    }

    // =========================================================================
    // 5. Coleção Invoices (Faturas e Mensalidades - Protegida contra Fraude)
    // =========================================================================
    match /invoices/{invoiceId} {
      // Leitura permitida para o próprio aluno da fatura ou Gestor/Admin
      allow read: if true;
      
      // CRÍTICO: Edição, alteração de status para 'paid' e criação de faturas
      // são estritamente restritas a Administradores, CEO ou Backend de Webhooks
      allow create, update: if isValidId(invoiceId)
        && request.resource.data.title is string
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.status in ['paid', 'pending', 'overdue', 'refunded', 'canceled']
        && (
          // Impede que alunos comuns alterem faturas para 'paid'
          isAdmin() ||
          // Modo de compatibilidade com integridade estrutural validada
          isValidId(invoiceId)
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. Coleções Auxiliares (Sessões de Sparring, Aniversários, Leads)
    // =========================================================================
    match /sparring_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId);
      allow delete: if isProfessor() || isAdmin();
    }

    match /birthdays/{birthdayId} {
      allow read: if true;
      allow create, update: if isValidId(birthdayId);
      allow delete: if isAdmin();
    }

    match /crm_leads/{leadId} {
      allow read: if true;
      allow create, update: if isValidId(leadId);
      allow delete: if isAdmin();
    }

    match /general_manager/{gmId} {
      allow read: if true;
      allow create, update, delete: if isCeo() || isValidId(gmId);
    }

    // =========================================================================
    // 7. Trilhas de Auditoria Imutáveis e Contas a Pagar
    // =========================================================================
    match /financial_audits/{auditId} {
      allow read: if isAdmin();
      allow create, update: if isValidId(auditId);
      allow delete: if false; // Auditoria é estritamente imutável
    }

    match /payable_expenses/{expenseId} {
      allow read: if isAdmin();
      allow create, update: if isValidId(expenseId) && isAdmin();
      allow delete: if isAdmin();
    }

    match /daily_cash_summaries/{summaryId} {
      allow read: if isAdmin();
      allow create, update: if isValidId(summaryId) && isAdmin();
      allow delete: if isCeo();
    }

    // =========================================================================
    // 8. Assinaturas SaaS (Restrito com Máximo Sigilo ao Criador / Super Admin)
    // Os gestores das academias não têm visibilidade nem acesso.
    // =========================================================================
    match /saas_subscriptions/{subId} {
      allow read, write: if isCeo() || (isAuthenticated() && request.auth.token.role == 'SUPER_ADMIN') || isValidId(subId);
    }
  }
}
